{
  "name": "rapid-diff",
  "version": "0.1.0",
  "description": "Fast line/word diffs and unified patches for every JavaScript runtime, with a jsdiff-compatible API. Rust core: native in Node and Bun, WebAssembly in browsers and edge.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnitish-dev/rapid-diff.git"
  },
  "homepage": "https://github.com/imnitish-dev/rapid-diff#readme",
  "bugs": "https://github.com/imnitish-dev/rapid-diff/issues",
  "engines": {
    "node": ">=20.19"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "workerd": {
        "types": "./index.d.ts",
        "default": "./lib/edge.js"
      },
      "edge-light": {
        "types": "./index.d.ts",
        "default": "./lib/edge.js"
      },
      "deno": {
        "types": "./index.d.ts",
        "default": "./lib/web.js"
      },
      "browser": {
        "types": "./index.d.ts",
        "default": "./lib/web.js"
      },
      "node": {
        "import": {
          "types": "./index.d.ts",
          "default": "./lib/node.mjs"
        },
        "require": {
          "types": "./index.d.cts",
          "default": "./lib/node.cjs"
        }
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./lib/web.js"
      }
    }
  },
  "files": [
    "lib",
    "native/*.node",
    "wasm/rapid_diff.js",
    "wasm/rapid_diff_bg.wasm",
    "index.d.ts",
    "index.d.cts",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "diff",
    "jsdiff",
    "patch",
    "unified-diff",
    "diffLines",
    "createPatch",
    "text-diff",
    "rust",
    "wasm",
    "napi"
  ],
  "napi": {
    "binaryName": "rapid-diff",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --features napi --output-dir native --no-js",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --features wasm && wasm-bindgen target/wasm32-unknown-unknown/release/rapid_diff.wasm --target web --out-dir wasm --out-name rapid_diff",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.11.1",
    "diff": "^9.0.0"
  }
}
